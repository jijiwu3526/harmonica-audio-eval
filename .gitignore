# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# 数据产物（音频与结果不入库）
# ★ 2026-09-25 修正：本节原先写的是 data/outputs/ · data/reference/ · data/user/，
#   而代码实际落盘到 data/out/ · data/ref/ · data/in/（__main__.py --out 默认值即
#   data/out/metrics.json）。三处规则全部指向不存在的目录，等于一条都没生效。
#   ★ 现按【代码实际写的路径】为准，旧路径一并保留以防将来真建。
data/out/*
!data/out/.gitkeep
data/ref/*
!data/ref/.gitkeep
data/in/*
!data/in/.gitkeep
data/outputs/*
!data/outputs/.gitkeep
data/reference/*
!data/reference/.gitkeep
data/user/*
!data/user/.gitkeep
*.wav
*.mp3
*.m4a
*.flac

# 评审/展示过程产物（不入库）
# ★ _scratch/ 是审查者 B 留下的参考实现副本；_scratch/_STALE_WARNING.md 明写
#   「不是主包镜像，也不应该被同步成主包」—— 分叉副本，入库会污染主包
_scratch/
# ★ .lavish/ 是 AI 生成的架构 HTML 展示件；docs/架构图.md 才是入库的事实源
.lavish/
# ★ _mold_hashes*.txt 是某一轮模具哈希的【历史快照】，不是持续维护的基线：
#   实测 38 条里 32 条已与当前文件失配（规格在注入过程中被反复修订）。
#   入库一份已失配的快照会误导后来者以为那是有效基线，故不入库。
_mold_hashes*.txt

# macOS
.DS_Store

# 大体积 vendor 资产：SoundFont 走脚本按需下载，不入库
vendor/soundfonts/*.sf2
vendor/soundfonts/*.sf3
vendor/VCSL/

# 生成的数据集产物（可通过 build_dataset.py 复现，不入库）
harmonica_mvp_dataset/*/
!harmonica_mvp_dataset/README.md

# React 前端（harmonica_eval_web/）的构建产物与依赖
node_modules/
harmonica_eval_web/dist/
local.properties
android/build/
android/app/build/
android/.gradle/
android/local.properties

# ★ 二进制产物不进库（★ 与「音频不进 git」同理）。
# ★ 三个 wheel 从 https://chaquo.com/pypi-13.1/ 下载，★ 复算命令见
# ★ android/app/build.gradle 的 pip 块注释。
android/app/wheels/*.whl

# ★ 本地验收工具与打包产物，不进版本库（★ 2026-09-26 加）
_acceptance/
build/
